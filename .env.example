# 인증 모드는 google 또는 mock입니다. mock은 개발 빌드에서만 활성화됩니다.
VITE_AUTH_MODE=google
# Google Cloud Console의 OAuth 2.0 클라이언트 ID를 입력합니다.
# Client ID는 공개 정보이지만 Client Secret은 절대 VITE_ 변수로 추가하지 마세요.
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# 쉼표로 구분한 이메일만 최고 관리자/관리자 메뉴를 봅니다.
VITE_SUPER_ADMIN_EMAILS=owner@example.com
VITE_ADMIN_EMAILS=admin@example.com
